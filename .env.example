# Environment & Device
APP_ENV=development
LOG_LEVEL=INFO
DEVICE_PREFERENCE=auto # auto, cuda, cpu

# ML Models
DETECTION_MODEL_PATH=models/det_10g.onnx
RECOGNITION_MODEL_PATH=models/w600k_r50.onnx
DETECTION_INPUT_SIZE=640,640
DETECTION_CONF_THRESHOLD=0.35
DETECTION_NMS_THRESHOLD=0.40

# Quality Filtering (Tuned for real-world webcam conditions)
MIN_FACE_SIZE=35
BLUR_THRESHOLD=10.0
MIN_BRIGHTNESS=30.0
MAX_BRIGHTNESS=235.0
MAX_YAW_DEG=50.0
MAX_PITCH_DEG=40.0
MIN_QUALITY_SCORE=0.20

# Recognition & Thresholds
SIMILARITY_THRESHOLD=0.40
UNKNOWN_THRESHOLD=0.35
TOP_K_CANDIDATES=5
EMBEDDING_DIM=512

# Tracking & Temporal Smoothing (Fast lock-on, zero flicker)
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=1
TRACKER_IOU_THRESHOLD=0.25
TEMPORAL_VOTE_WINDOW=4
TEMPORAL_CONFIRM_THRESHOLD=0.40
DETECTION_INTERVAL=1
RECOGNITION_INTERVAL=2

# Camera Settings
DEFAULT_CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/classroom_faces.db
FAISS_INDEX_PATH=data/embeddings/faiss.index
METADATA_STORE_PATH=data/embeddings/metadata.json
FACES_DIR=data/faces

# Security
SECRET_KEY=super-secret-production-key-change-me-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
