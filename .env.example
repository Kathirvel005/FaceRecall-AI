# Environment & Device
APP_ENV=development
LOG_LEVEL=INFO
DEVICE_PREFERENCE=auto # auto, cuda, cpu

# ML Models
DETECTION_MODEL_PATH=models/det_10g.onnx
RECOGNITION_MODEL_PATH=models/w600k_r50.onnx
DETECTION_INPUT_SIZE=640,640
DETECTION_CONF_THRESHOLD=0.50
DETECTION_NMS_THRESHOLD=0.40

# Quality Filtering
MIN_FACE_SIZE=60
BLUR_THRESHOLD=50.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=220.0
MAX_YAW_DEG=35.0
MAX_PITCH_DEG=30.0
MIN_QUALITY_SCORE=0.55

# Recognition & Thresholds
SIMILARITY_THRESHOLD=0.50
UNKNOWN_THRESHOLD=0.40
TOP_K_CANDIDATES=5
EMBEDDING_DIM=512

# Tracking & Temporal Smoothing
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
TRACKER_IOU_THRESHOLD=0.3
TEMPORAL_VOTE_WINDOW=8
TEMPORAL_CONFIRM_THRESHOLD=0.60
DETECTION_INTERVAL=2
RECOGNITION_INTERVAL=5

# Camera Settings
DEFAULT_CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/classroom_faces.db
FAISS_INDEX_PATH=data/embeddings/faiss.index
METADATA_STORE_PATH=data/embeddings/metadata.json
FACES_DIR=data/faces

# Security
SECRET_KEY=super-secret-production-key-change-me-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
